{
  "manifest_version": 3,
  "name": "Tab Wise",
  "version": "2.7.0",
  "description": "Organize and manage your Chrome tabs efficiently with a modern React interface",
  "permissions": ["tabs", "tabGroups", "storage", "sidePanel", "contextMenus", "sessions", "favicon", "unlimitedStorage", "alarms"],
  "optional_permissions": ["system.memory"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": ["https://tabwise.visionly.dev/*", "http://localhost:3000/*"]
  },
  "action": {
    "default_title": "Open Tab Wise"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Alt+Shift+Y"
      },
      "description": "Open Tab Wise"
    },
    "add-to-workspace": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "Alt+Shift+W"
      },
      "description": "Add this page to its workspace"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "icons": {
    "16": "icons/tw_light_icon.png",
    "48": "icons/tw_light_icon.png",
    "128": "icons/tw_light_icon.png"
  }
}
